# ─────────────────────────────────────────────────────────────────────────
# Encryption Gateway — configuration
# Copy to .env (`cp .env.example .env`). On hosting platforms (Vercel/Railway/Render),
# set these in your environment dashboard.
# ─────────────────────────────────────────────────────────────────────────

PORT=3000

# Requests always encrypted. true = encrypted response; false = plain JSON response.
# Plain responses require requireEncryptedResponse=false in the client SDK.
ENCRYPT_RESPONSE=true

# [PROD] Server private key.
# Development automatically generates a missing key in keys/private.pem.
# Production requires a configured/existing key, or AUTO_GENERATE_KEYS=true
# with persistent storage (e.g. Docker's gateway-keys volume).
# For cloud PaaS (Vercel, Railway, Render, Fly.io), paste the base64 output of `npm run keygen`:
RSA_PRIVATE_KEY=
# Or path to private key file:
# RSA_PRIVATE_KEY_PATH=keys/private.pem

# Optional explicit override: true allows generation, false disables it.
# Unset = enabled in development, disabled in production and tests.
# AUTO_GENERATE_KEYS=false

# [PROD] Whitelist endpoints the gateway is allowed to forward to.
# Format: "[METHOD] host/path", comma-separated. Trailing * matches all sub-paths.
#   POST api.example.com/api/login
#   GET api.example.com/api/products/*
#   api.example.com/api/* (any method)
ALLOWED_ROUTES=localhost:4000/api/*

# Whole host allowed (optional alternative to ALLOWED_ROUTES)
ALLOWED_TARGET_HOSTS=

# [PROD] Set to false in production (enforce https:// to your upstream API).
ALLOW_HTTP_UPSTREAM=true

# Timeout for upstream API calls (ms).
UPSTREAM_TIMEOUT_MS=15000

# Maximum upstream response size after decompression (bytes, default 5 MiB).
MAX_UPSTREAM_RESPONSE_BYTES=5242880

# Max request body size (e.g. 1mb, 5mb)
MAX_BODY_SIZE=1mb

# Browser origins allowed to call the gateway (CORS), comma-separated.
# E.g.: https://app.example.com. Leave empty for mobile-only apps.
CORS_ORIGINS=

# Trust only your proxy IP/subnet, or 1 for exactly one trusted proxy hop.
# Do not expose the gateway directly when trusting forwarded headers.
TRUST_PROXY=

# Rate limiting per IP (IPv6 is grouped by /64)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
THROTTLE_MAX_ENTRIES=10000

# Optional replay protection. Off by default so existing clients keep working.
# When true, encrypted payloads must include a unique `Nonce` (16-128 visible
# ASCII characters) and a `Timestamp` (ISO-8601 or epoch seconds/milliseconds).
REQUIRE_REQUEST_NONCE=false
REQUEST_MAX_SKEW_MS=60000
REPLAY_CACHE_MAX_ENTRIES=10000

# ─────────────────────────────────────────────────────────────────────────
# Optional Android Key Attestation (/v1/* endpoints)
# Leave both empty to keep the endpoints disabled (503).
# ─────────────────────────────────────────────────────────────────────────
ATTESTATION_PACKAGE_NAME=
ATTESTATION_SIGNING_CERT_SHA256=
# Accept software attestation from any root. Development/test only; startup
# fails if this is true while NODE_ENV=production.
# ATTESTATION_ALLOW_SOFTWARE=false
# Reject unsigned requests to routes protected by DeviceSignatureGuard.
# ATTESTATION_DEVICE_POLICY=required
# Comma-separated revoked certificate serials (colons optional).
# ATTESTATION_REVOKED_SERIALS=
# Shared Upstash/Vercel KV for challenges and enrolments. Required on
# serverless or multi-instance hosting; both must be set together.
# ATTESTATION_KV_REST_URL=
# ATTESTATION_KV_REST_TOKEN=
